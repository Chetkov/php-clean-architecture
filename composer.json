{
    "name": "v.chetkov/php-clean-architecture",
    "type": "library",
    "description": "PHP Clean Architecture",
    "license": "MIT",
    "authors": [
        {
            "name": "Валерий Четков",
            "email": "chetkov.valeriy@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "nikic/php-parser": "^5.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.6",
        "phpunit/phpunit": "^12",
        "phan/phan": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "Chetkov\\PHPCleanArchitecture\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chetkov\\PHPCleanArchitecture\\Tests\\": "tests/"
        }
    },
    "bin": [
      "/bin/phpca-build-reports",
      "/bin/phpca-check",
      "/bin/phpca-allow-current-state",
      "/bin/phpca-debug-unmatched-files"
    ],
    "scripts": {
        "php-linter": "php -l bin && php -l src",
        "test": "vendor/bin/phpunit",
        "code-sniffer": "vendor/bin/phpcs bin src tests",
        "phpstan": "php -d memory_limit=1024M vendor/bin/phpstan analyse --configuration=phpstan.neon --error-format=table --no-progress",
        "phan": "vendor/bin/phan --config-file .phan/config.php --no-progress-bar --allow-polyfill-parser",
        "php-clean-architecture": "bin/phpca-check ./phpca-config.php",
        "quality-checker": [
            "@php-linter",
            "@code-sniffer",
            "@phpstan",
            "@phan",
            "@php-clean-architecture"
        ]
    }
}
