#!/usr/bin/env php
<?php

use Chetkov\PHPCleanArchitecture\ConfigTreeRunner;
use Chetkov\PHPCleanArchitecture\Service\Config\ConfigTreeBuilder;

require_once resolveAutoloadPath();

$options = parseArguments($argv);
$configPath = $options['configPath'];
$config = require $configPath;

$configTree = (new ConfigTreeBuilder())->build($config);
$reportsPath = $configTree->reportPath();
recreateReportsDirectory($reportsPath);

$allowedPaths = array_filter(explode(PHP_EOL, getenv('PHPCA_ALLOWED_PATHS'))) ?: [];
(new ConfigTreeRunner())->generateReports($configTree, $allowedPaths, $options['recordHistory']);

echo PHP_EOL . 'Report: ' . $reportsPath . '/index.html' . PHP_EOL;




// helpers

function resolveAutoloadPath(): string
{
    $candidates = [
        dirname(__DIR__) . '/vendor/autoload.php',
        dirname(__DIR__, 3) . '/autoload.php',
    ];

    foreach ($candidates as $candidate) {
        if (file_exists($candidate)) {
            return $candidate;
        }
    }

    throw new \RuntimeException('Composer autoload.php was not found.');
}

function resolveDefaultConfigPath(): string
{
    $candidates = [
        dirname(__DIR__) . '/phpca-config.php',
        dirname(__DIR__, 4) . '/phpca-config.php',
    ];

    foreach ($candidates as $candidate) {
        if (file_exists($candidate)) {
            return $candidate;
        }
    }

    return dirname(__DIR__) . '/phpca-config.php';
}

function recreateReportsDirectory(string $path): void
{
    removeDirectory($path);
    if (!mkdir($path, 0777, true) && !is_dir($path)) {
        throw new \RuntimeException(sprintf('Directory "%s" was not created', $path));
    }
}

function removeDirectory(string $path): void
{
    if (is_dir($path)) {
        $files = glob($path . '/*');
        foreach ($files as $file) {
            is_dir($file) ? removeDirectory($file) : unlink($file);
        }
        rmdir($path);
    }
}

/**
 * @param array<int, string> $argv
 *
 * @return array{configPath: string, recordHistory: bool}
 */
function parseArguments(array $argv): array
{
    $configPath = null;
    $recordHistory = false;
    foreach (array_slice($argv, 1) as $argument) {
        if ($argument === '--with-history') {
            $recordHistory = true;
            continue;
        }

        if ($configPath === null) {
            $configPath = $argument;
        }
    }

    return [
        'configPath' => $configPath ?? resolveDefaultConfigPath(),
        'recordHistory' => $recordHistory,
    ];
}
